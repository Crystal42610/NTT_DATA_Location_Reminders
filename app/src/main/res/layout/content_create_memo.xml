<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/memo_title_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:errorEnabled="true" xmlns:app="http://schemas.android.com/apk/res-auto">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/memo_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences"
                android:hint="@string/memo_title" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/memo_description_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:errorEnabled="true" xmlns:app="http://schemas.android.com/apk/res-auto">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/memo_description" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="@string/memo_text"
                android:inputType="textMultiLine|textCapSentences" android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/map_prompt" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/map_prompt" android:textStyle="bold" android:paddingTop="14dp"
            android:paddingBottom="8dp" />
        <FrameLayout android:id="@+id/map_container" android:layout_width="match_parent"
            android:layout_height="270dp" android:background="#E6F0F1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/map_attribution" android:textSize="11sp"
            android:gravity="end" android:paddingTop="4dp" />
        <TextView android:id="@+id/selected_location" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:text="@string/location_required" />
    </LinearLayout>
</ScrollView>
